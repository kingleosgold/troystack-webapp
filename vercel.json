{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.troystack.com"
        }
      ],
      "destination": "https://troystack.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.troystack.com"
        }
      ],
      "destination": "https://troystack.com/:path*",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/today",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/stack",
      "permanent": true
    },
    {
      "source": "/analytics",
      "destination": "/stack",
      "permanent": true
    },
    {
      "source": "/speculate",
      "destination": "/tools/what-if",
      "permanent": true
    },
    {
      "source": "/junk-silver",
      "destination": "/tools/junk-silver",
      "permanent": true
    },
    {
      "source": "/chat",
      "destination": "/troy",
      "permanent": true
    },
    {
      "source": "/c/:conversationId",
      "destination": "/troy/c/:conversationId",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "/auth?mode=signup",
      "permanent": false
    },
    {
      "source": "/sign-up",
      "destination": "/auth?mode=signup",
      "permanent": false
    },
    {
      "source": "/register",
      "destination": "/auth?mode=signup",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/auth?mode=signin",
      "permanent": false
    },
    {
      "source": "/log-in",
      "destination": "/auth?mode=signin",
      "permanent": false
    },
    {
      "source": "/signin",
      "destination": "/auth?mode=signin",
      "permanent": false
    },
    {
      "source": "/sign-in",
      "destination": "/auth?mode=signin",
      "permanent": false
    },
    {
      "source": "/pricing",
      "destination": "/gold",
      "permanent": false
    },
    {
      "source": "/plans",
      "destination": "/gold",
      "permanent": false
    },
    {
      "source": "/premium",
      "destination": "/gold",
      "permanent": false
    },
    {
      "source": "/upgrade",
      "destination": "/gold",
      "permanent": false
    },
    {
      "source": "/subscribe",
      "destination": "/gold",
      "permanent": false
    },
    {
      "source": "/lifetime",
      "destination": "/gold",
      "permanent": false
    },
    {
      "source": "/faq",
      "destination": "/gold",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/help",
      "destination": "/settings",
      "permanent": false
    },
    {
      "source": "/support",
      "destination": "/settings",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/settings",
      "permanent": false
    },
    {
      "source": "/auth/reset-password",
      "destination": "/reset-password",
      "permanent": false
    },
    {
      "source": "/auth/reset-password/:path*",
      "destination": "/reset-password",
      "permanent": false
    },
    {
      "source": "/signal-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.troystack.ai"
        }
      ],
      "destination": "https://troystack.ai/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.troystack.ai"
        }
      ],
      "destination": "https://troystack.ai/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/troy/c/:conversationId",
      "destination": "/"
    },
    {
      "source": "/settings",
      "destination": "/"
    },
    {
      "source": "/auth",
      "destination": "/"
    },
    {
      "source": "/reset-password",
      "destination": "/"
    },
    {
      "source": "/developers/keys",
      "destination": "/"
    },
    {
      "source": "/signal/:slug",
      "destination": "/api/signal-html?slug=:slug"
    },
    {
      "source": "/coins/:slug",
      "destination": "/api/coin-html?slug=:slug"
    },
    {
      "source": "/tools/junk-silver",
      "destination": "/api/coin-html?page=junk-silver"
    }
  ],
  "functions": {
    "api/coin-html.js": {
      "includeFiles": "{dist/_ssr/**,dist/404.html,src/lib/coins.json,src/lib/coinCopy.json,src/lib/junkSilverPage.json}"
    }
  },
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/_ssr/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
